#!/usr/bin/env bash
# Install the latest SIGNED WazuhMCP release: binary only (unit, env, certs and
# Wazuh accounts stay manual). Refuses a bad signature or an older version, and
# rolls back if the service does not come up.
#   sudo wazuhmcp-update                  # download the latest GitHub release
#   sudo wazuhmcp-update --from-dir DIR   # offline: DIR holds the .tar.gz and .tar.gz.sig
set -euo pipefail
umask 022

REPO="${WAZUHMCP_UPDATE_REPO:-aminkubator/wazuhmcp}"
SIGNERS="${WAZUHMCP_SIGNERS:-/etc/wazuhmcp/allowed_signers}"
BIN="${WAZUHMCP_BIN:-/usr/local/bin/wazuhmcp}"
SERVICE=wazuhmcp
ASSET=wazuhmcp-linux-amd64.tar.gz
NS=wazuhmcp-release # signature namespace: a key used for other things cannot sign releases
semver='^v[0-9]+\.[0-9]+\.[0-9]+$'

log() { echo "wazuhmcp-update: $*"; }
die() { log "ERROR: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "run as root"
[ -s "$SIGNERS" ] || die "missing $SIGNERS (public key of the release signer)"
[[ $REPO =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "invalid repo $REPO"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if [ "${1:-}" = --from-dir ]; then
  [ -n "${2:-}" ] || die "--from-dir needs a directory"
  cp -- "$2/$ASSET" "$2/$ASSET.sig" "$work/"
else
  base="https://github.com/$REPO/releases/latest/download"
  for f in "$ASSET" "$ASSET.sig"; do
    curl -fsSL --proto '=https' --tlsv1.2 --max-filesize 52428800 -o "$work/$f" "$base/$f" ||
      die "download of $f failed"
  done
fi

ssh-keygen -Y verify -f "$SIGNERS" -I "$NS" -n "$NS" -s "$work/$ASSET.sig" < "$work/$ASSET" >/dev/null 2>&1 ||
  die "signature check FAILED: not installing"

mkdir "$work/x"
tar -xzf "$work/$ASSET" -C "$work/x" --no-same-owner --wildcards '*/wazuhmcp'
new=("$work"/x/wazuhmcp-*-linux-amd64/wazuhmcp)
[ ${#new[@]} = 1 ] && [ -f "${new[0]}" ] || die "binary not found in $ASSET"
new=${new[0]}

newv=$("$new" version | awk '{print $2}')
curv=$("$BIN" version 2>/dev/null | awk '{print $2}' || true)
[[ $newv =~ $semver ]] || die "release version '$newv' is not vX.Y.Z"
if [ "$newv" = "$curv" ]; then log "already at $curv"; exit 0; fi
# Anti-rollback: never go back to an older (possibly vulnerable) signed release.
if [[ $curv =~ $semver ]] && [ "$(printf '%s\n%s\n' "$curv" "$newv" | sort -V | tail -1)" = "$curv" ]; then
  die "release $newv is older than installed $curv: refusing downgrade"
fi

log "updating ${curv:-none} -> $newv"
rm -f -- "$BIN.prev" # a stale backup from an older run must never be "restored"
[ -f "$BIN" ] && cp -p -- "$BIN" "$BIN.prev"
install -m 0755 "$new" "$BIN.new"
mv -f -- "$BIN.new" "$BIN"

restarts=$(systemctl show -P NRestarts "$SERVICE")
systemctl restart "$SERVICE"
sleep "${WAZUHMCP_HEALTH_WAIT:-10}"
if systemctl is-active --quiet "$SERVICE" && [ "$(systemctl show -P NRestarts "$SERVICE")" = "$restarts" ]; then
  log "running $newv"
  exit 0
fi
[ -f "$BIN.prev" ] || die "$newv failed to start and there is no previous binary"
mv -f -- "$BIN.prev" "$BIN"
systemctl restart "$SERVICE"
die "$newv failed to start: rolled back to $curv (see journalctl -u $SERVICE)"
