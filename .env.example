# Wazuh server API (port 55000) and Indexer (port 9200)
WAZUHMCP_API_URL=https://host.docker.internal:55000
WAZUHMCP_API_USER=wazuh-wui
WAZUHMCP_API_PASSWORD=
WAZUHMCP_INDEXER_URL=https://host.docker.internal:9200
WAZUHMCP_INDEXER_USER=admin
WAZUHMCP_INDEXER_PASSWORD=

# Wazuh root CA (mounted by compose.yaml from ./certs/root-ca.pem).
# Wazuh certs carry DNS names only, so tell TLS which name to expect.
WAZUHMCP_CA_FILE=/certs/root-ca.pem
WAZUHMCP_API_TLS_NAME=localhost
WAZUHMCP_INDEXER_TLS_NAME=wazuh.indexer

# Tokens: generate with `openssl rand -hex 24`. They must differ.
# TOKEN goes to the AI client; ADMIN_TOKEN stays with humans (plan approval).
WAZUHMCP_TOKEN=
WAZUHMCP_ADMIN_TOKEN=

# readonly | propose | approve | auto
WAZUHMCP_AUTONOMY=approve
WAZUHMCP_PROTECTED_IPS=
