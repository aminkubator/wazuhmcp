# /etc/wazuhmcp/wazuhmcp.env  (root:wazuhmcp 0640) — holds secrets

# HTTPS for MCP clients on other hosts. Firewall this port to the client IPs only.
WAZUHMCP_ADDR=0.0.0.0:8090
WAZUHMCP_TLS_CERT=/etc/wazuhmcp/tls.crt
WAZUHMCP_TLS_KEY=/etc/wazuhmcp/tls.key

# Wazuh on this same host
WAZUHMCP_API_URL=https://127.0.0.1:55000
WAZUHMCP_API_USER=wazuhmcp
WAZUHMCP_API_PASSWORD=
WAZUHMCP_INDEXER_URL=https://127.0.0.1:9200
WAZUHMCP_INDEXER_USER=wazuhmcp
WAZUHMCP_INDEXER_PASSWORD=

# Trust: Wazuh API cert (self-signed) + indexer root CA, merged into one file.
WAZUHMCP_CA_FILE=/etc/wazuhmcp/wazuh-ca.pem
# Name the API certificate is issued for (default Wazuh API cert: localhost).
WAZUHMCP_API_TLS_NAME=localhost
# Indexer cert here lists IP 127.0.0.1, which matches the URL: no override needed.
WAZUHMCP_INDEXER_TLS_NAME=

# MCP token (given to the AI client) and admin token (humans only). Different values:
#   openssl rand -hex 24
WAZUHMCP_TOKEN=
WAZUHMCP_ADMIN_TOKEN=

# readonly | propose | approve | auto
WAZUHMCP_AUTONOMY=approve
# Never block these (comma separated IPs/CIDRs). Keep the AI client host (server02) and
# this Wazuh server: blocking the manager's IP on an agent cuts the agent off from it.
# Add the security team's admin/VPN addresses too.
WAZUHMCP_PROTECTED_IPS=182.253.222.86,163.7.16.251
# agent 000 (the manager) is always protected
WAZUHMCP_PROTECTED_AGENTS=
